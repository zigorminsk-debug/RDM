<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RDM" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="RdmFieldLabel">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="RdmSectionLabel">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
